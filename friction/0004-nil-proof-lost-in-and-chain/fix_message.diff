-          buildErr c, n.info, "cannot prove expression is not nil: " & asNimCode(n)
+          buildErr c, n.info, "cannot prove expression is not nil: " & renderForNilMsg(c, n)
 
 proc checkNilMatch(c: var FirContext; n: Cursor; expected: Cursor) =
   if markedAs(expected, NotnilU):
@@ -5098,7 +5107,9 @@ proc traverseLocal(c: var FirContext; n: var Cursor; call: var CallContext) =
