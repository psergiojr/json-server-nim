@@ -2802,6 +2802,15 @@ proc isConvertedNil(n: Cursor): bool =
     skip n # the target type
   result = n.exprKind == NilX
 
+proc renderForNilMsg(c: var FirContext; n: Cursor): string =
+  ## A compiler temporary (`xelim`'s `` `x.N ``) has no source spelling; its
+  ## basename renders as a lone `` `x ``. Show what it was bound to instead.
+  result = asNimCode(n)
+  if n.kind == Symbol and result.len > 0 and result[0] == '`':
+    let x = getLocalInfo(c.typeCache, n.symId)
+    if not cursorIsNil(x.val) and x.val.kind != DotToken:
+      result = asNimCode(x.val)
+
 proc wantNotNil(c: var FirContext; n: Cursor) =
   case n.exprKind
   of NilX:
@@ -2838,7 +2847,7 @@ proc wantNotNil(c: var FirContext; n: Cursor) =
