+proc trShortCircuitViaCx(c: var Context; dest: var TokenBuf; n: var Cursor;
+                         tar: var Target; isAnd: bool) =
+  ## A value-position `a and b` / `a or b` whose `a` is itself a short-circuit
+  ## spine. `a` is compiled against jump targets (like an `if` condition) rather
+  ## than materialised into a bool temp that the next diamond re-tests, so
+  ## the facts `a` establishes still hold where `b` is evaluated:
+  ##
+  ##   and:  (var tmp) (scope Cjmp(a)(Lf, false) tmp = b) (jmp Lend)
+  ##         (lab Lf) tmp = false (lab Lend)
+  ##   or:   (var tmp) (scope Cjmp(a)(Lf, true)  tmp = b) (jmp Lend)
+  ##         (lab Lf) tmp = true  (lab Lend)
+  let info = n.info
+  let tmp = declareTempBool(c, dest, info)
+  let shortLab = freshLabel(c)
+  let endLab = freshLabel(c)
+  n.into:
+    let lhs = n
+    skip n
+    var rhs = createTokenBuf(16)
+    hoistDeclsFromExprX(c.typeCache, dest, rhs, n, markNoinit = c.goal == TowardsFinalIr)
+    var rhsCursor = beginRead(rhs)
+    var l = lhs
+    dest.addParLe(ScopeS, info)
+    c.typeCache.openScope()
+    # and: jump to shortLab when `a` is false; or: when `a` is true
+    trExprToLabel c, dest, l, shortLab, not isAnd, false
+    trExprInto c, dest, rhsCursor, tmp
+    c.typeCache.closeScope()
+    dest.addParRi()
+    addJmp dest, endLab, info
+    addLab dest, shortLab, info
+    copyIntoKind dest, AsgnS, info:
+      dest.addSymUse tmp, info
+      if isAnd:
+        copyIntoKind dest, FalseX, info: discard
+      else:
+        copyIntoKind dest, TrueX, info: discard
+    addLab dest, endLab, info
+  tar.t.addSymUse tmp, info
+
