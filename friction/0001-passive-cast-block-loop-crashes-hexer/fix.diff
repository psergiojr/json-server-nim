             DiscardS, UnpackdeclS, AssumeS,
@@ -1577,6 +1577,31 @@ proc trGoto*(c: var Context; dest: var TokenBuf; n: var Cursor) =
             while n.hasMore:
               trGoto c, dest, n
           dest.addParRi()
+        of PragmaxS:
+          # `(pragmax (pragmas ...) body)` has exactly ONE body slot, and
+          # later passes (`constparams.trPragmaBlock`, `xelim`) rely on that.
+          # The generic arm above would let the `StmtsS` flattening below
+          # splice the body's statements straight into the `pragmax`.
+          if containsSuspensionPoint(c, n):
+            # A state label has to live at the top level of the body, so the
+            # wrapper cannot survive. A `cast` pragma only matters to sema
+            # (`constparams` drops it anyway): lay its body out flat.
+            let pragmaxStart = n
+            var p = sub(n)                 # (pragmas ...)
+            var pk = sub(p)
+            if pk.pragmaKind != CastP:
+              bug "suspension point inside a pragma block: " & toString(pragmaxStart, false)
+            skip p
+            while p.hasMore:
+              trGoto c, dest, p
+            n = pragmaxStart; skip n
+          else:
+            dest.addParLe(n.cursorTagId, n.info)
+            n.into:
+              dest.takeTree n              # (pragmas ...)
+              while n.hasMore:
+                trGotoScoped c, dest, n    # the body: one `(stmts ...)`
+            dest.addParRi()
         of CaseS:
