           # unlike `nj.nim` — which lowered every branch to an `ite` chain —
diff --git a/tests/nimony/cps/tpassive_pragma_block.nim b/tests/nimony/cps/tpassive_pragma_block.nim
new file mode 100644
index 0000000..249f975
--- /dev/null
+++ b/tests/nimony/cps/tpassive_pragma_block.nim
@@ -0,0 +1,48 @@
+import std/syncio
+
+proc inner(): int {.passive.} =
+  suspend()
+  result = 10
+
+iterator items2(s: seq[int]): int =
+  {.cast(noSideEffect).}:
+    for x in s: yield x
+
+proc countFor(s: seq[int]): int {.passive.} =
+  result = 0
+  {.cast(noSideEffect).}:
+    for x in s: inc result
+
+proc countIter(s: seq[int]): int {.passive.} =
+  result = 0
+  for x in items2(s): inc result
+
+proc countWhile(s: seq[int]): int {.passive.} =
+  result = 0
+  {.cast(noSideEffect).}:
+    var i = 0
+    while i < s.len:
+      inc result
+      inc i
+
+proc twoStmts(): int {.passive.} =
+  result = 0
+  {.cast(uncheckedAssign).}:
+    inc result
+    inc result
+
+proc suspendInside(): int {.passive.} =
+  result = 0
+  {.cast(noSideEffect).}:
+    inc result
+    result += inner()
+    inc result
+
+proc main() {.passive.} =
+  echo countFor(@[1, 2, 3])
+  echo countIter(@[1, 2, 3, 4])
+  echo countWhile(@[1, 2])
+  echo twoStmts()
+  echo suspendInside()
+
+main()
